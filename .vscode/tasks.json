{
    "version": "2.0.0",
    "options": {"env": {"gen": "Unix Makefiles"}},
    "linux": {"options": {"env": {"UNA_SDK" : "${workspaceFolder}"}}},
    "tasks": [
        {
            "label": "Build Running CMake in Docker",
            "type": "shell",
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-v",
                "${workspaceFolder}:/workspace",
                "-e",
                "UNA_WORKSPACE=/workspace/Examples",
                "-e",
                "UNA_SDK=/workspace",
                "xanderhendriks/stm32cubeide:16.0",
                "bash",
                "-c",
                ". /workspace/Utilities/Scripts/build-cube/setup-environment.sh && apt-get install -y cmake && cd /workspace/Examples/Apps/Running/Software/Apps/Running-CMake && mkdir -p build && cd build && cmake .. && make"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "CMake: Running Build",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd ${workspaceFolder}/Examples/Apps/Running/Software/Apps/Running-CMake && mkdir -p build && cd build && cmake .. && make"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "cd ${workspaceFolder}\\Examples\\Apps\\Running\\Software\\Apps\\Running-CMake ; if (!(Test-Path build)) { New-Item -ItemType Directory -Force build } ; cmake -G \"${ENV:gen}\" -S . -B build ; cmake --build build"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": true,
                "panel": "dedicated"
            },
        },
        {
            "label": "CMake: Running Clean",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "cd ${workspaceFolder}/Examples/Apps/Running/Software/Apps/Running-CMake && rm -rf build"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "cd ${workspaceFolder}\\Examples\\Apps\\Running\\Software\\Apps\\Running-CMake ; if (Test-Path build) { Remove-Item -Recurse -Force build }"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "dedicated"
            }
        },
