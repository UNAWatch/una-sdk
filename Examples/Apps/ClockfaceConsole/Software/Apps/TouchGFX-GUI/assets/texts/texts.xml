<?xml version="1.0" encoding="utf-8"?>
<TextDatabase xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="texts.xsd" Version="4.26.1">
  <Languages>
    <Language Id="GB" />
  </Languages>
  <Texts>
    <TextGroup Id="Template">
      <Text Id="TMP_CONSOLE_WEEKDAY" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="TMP_CONSOLE_DAY" Alignment="Center" TypographyId="PlexMono_SemiBold_85">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="TMP_CONSOLE_MONTH" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="TMP_CONSOLE_CLOCK" Alignment="Left" TypographyId="PlexMono_Medium_36">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
      <Text Id="TMP_CONSOLE_STEPS" Alignment="Left" TypographyId="Poppins_Medium_14">
        <Translation Language="GB">&lt;&gt;</Translation>
      </Text>
    </TextGroup>
    <TextGroup Id="Clock">
      <Text Id="TEXT_CONSOLE_COLON" Alignment="Center" TypographyId="PlexMono_Medium_36">
        <Translation Language="GB">:</Translation>
      </Text>
    </TextGroup>
    <!-- The weekday and month names are read back with TypedText::getText() and
         written into their wildcards, so every glyph they can contain is also
         in the two typographies' WildcardCharacters. They are Texts rather than
         string literals so that translating them stays a text database job.
         The names are spelled out in full and abbreviated respectively, which
         is what the design shows. -->
    <TextGroup Id="Day">
      <Text Id="TEXT_SUN" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">SUNDAY</Translation>
      </Text>
      <Text Id="TEXT_MON" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">MONDAY</Translation>
      </Text>
      <Text Id="TEXT_TUE" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">TUESDAY</Translation>
      </Text>
      <Text Id="TEXT_WED" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">WEDNESDAY</Translation>
      </Text>
      <Text Id="TEXT_THU" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">THURSDAY</Translation>
      </Text>
      <Text Id="TEXT_FRI" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">FRIDAY</Translation>
      </Text>
      <Text Id="TEXT_SAT" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">SATURDAY</Translation>
      </Text>
    </TextGroup>
    <TextGroup Id="Month">
      <Text Id="TEXT_JAN" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">JAN</Translation>
      </Text>
      <Text Id="TEXT_FEB" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">FEB</Translation>
      </Text>
      <Text Id="TEXT_MAR" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">MAR</Translation>
      </Text>
      <Text Id="TEXT_APR" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">APR</Translation>
      </Text>
      <Text Id="TEXT_MAY" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">MAY</Translation>
      </Text>
      <Text Id="TEXT_JUN" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">JUN</Translation>
      </Text>
      <Text Id="TEXT_JUL" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">JUL</Translation>
      </Text>
      <Text Id="TEXT_AUG" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">AUG</Translation>
      </Text>
      <Text Id="TEXT_SEP" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">SEP</Translation>
      </Text>
      <Text Id="TEXT_OCT" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">OCT</Translation>
      </Text>
      <Text Id="TEXT_NOV" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">NOV</Translation>
      </Text>
      <Text Id="TEXT_DEC" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">DEC</Translation>
      </Text>
    </TextGroup>
    <!-- The meridiem is a static label beside the clock rather than part of a
         wildcard, because it is the one piece of the clock group whose text
         never varies beyond two values. -->
    <TextGroup Id="Meridiem">
      <Text Id="TEXT_CONSOLE_AM" Alignment="Left" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">am</Translation>
      </Text>
      <Text Id="TEXT_CONSOLE_PM" Alignment="Left" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">pm</Translation>
      </Text>
    </TextGroup>
    <!-- Wildcard seeds. Dashes rather than plausible readings, so a value the
         face forgets to set shows as missing instead of as data. -->
    <TextGroup Id="Wildcard">
      <Text Id="WC_CONSOLE_WEEKDAY" Alignment="Center" TypographyId="PlexMono_Medium_16">
        <Translation Language="GB">---</Translation>
      </Text>
      <Text Id="WC_CONSOLE_DAY" Alignment="Center" TypographyId="PlexMono_SemiBold_85">
        <Translation Language="GB">--</Translation>
      </Text>
      <Text Id="WC_CONSOLE_MONTH" Alignment="Center" TypographyId="PlexMono_Medium_20">
        <Translation Language="GB">---</Translation>
      </Text>
      <Text Id="WC_CONSOLE_HOUR" Alignment="Left" TypographyId="PlexMono_Medium_36">
        <Translation Language="GB">--</Translation>
      </Text>
      <Text Id="WC_CONSOLE_MINUTE" Alignment="Left" TypographyId="PlexMono_Medium_36">
        <Translation Language="GB">--</Translation>
      </Text>
      <Text Id="WC_CONSOLE_STEPS" Alignment="Left" TypographyId="Poppins_Medium_14">
        <Translation Language="GB">---</Translation>
      </Text>
    </TextGroup>
  </Texts>
  <Typographies>
    <Typography Id="PlexMono_SemiBold_85" Font="IBMPlexMono-SemiBold.ttf" Size="85" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789-" EllipsisCharacter="…" />
    <Typography Id="PlexMono_Medium_36" Font="IBMPlexMono-Medium.ttf" Size="36" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789-" EllipsisCharacter="…" />
    <Typography Id="PlexMono_Medium_20" Font="IBMPlexMono-Medium.ttf" Size="20" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="ABCDEFGHIJKLMNOPQRSTUVWXYZ-" EllipsisCharacter="…" />
    <Typography Id="PlexMono_Medium_16" Font="IBMPlexMono-Medium.ttf" Size="16" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="ABCDEFGHIJKLMNOPQRSTUVWXYZ-" EllipsisCharacter="…" />
    <Typography Id="Poppins_Medium_14" Font="Poppins-Medium.ttf" Size="14" Bpp="4" IsVector="no" Direction="LTR" FallbackCharacter="?" WildcardCharacters="0123456789,-" EllipsisCharacter="…" />
  </Typographies>
</TextDatabase>
