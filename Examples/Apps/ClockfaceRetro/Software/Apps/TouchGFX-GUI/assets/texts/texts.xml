    <!-- Day, month and meridiem names are read back with TypedText::getText()
         and written into the date wildcard, so every glyph they can contain has
         to be in Doto_Black_18's WildcardCharacters as well. They are Texts
         rather than string literals so that translating them stays a text
         database job. -->
    <TextGroup Id="Day">
      <Text Id="TEXT_SUN" Alignment="Center" TypographyId="Doto_Black_18">
        <Translation Language="GB">SUN</Translation>
      </Text>
      <Text Id="TEXT_MON" Alignment="Center" TypographyId="Doto_Black_18">
